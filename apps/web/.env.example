# Public configuration only. Every VITE_ variable is shipped to the browser.
# Never put client secrets, AWS keys, private keys, certificates or passwords here.

# Microsoft Entra tenant (directory) ID
VITE_ENTRA_TENANT_ID=

# Application (client) ID of the single Entra app registration
VITE_ENTRA_CLIENT_ID=

# Delegated API scope exposed by the same registration
VITE_ENTRA_API_SCOPE=api://<CLIENT_ID>/access_as_user

# Base URL of the API Gateway HTTP API (no trailing slash)
VITE_API_BASE_URL=https://api.dev.example.com

# Optional: dedicated redirect path registered in Entra (defaults to "/")
# VITE_ENTRA_REDIRECT_PATH=/auth/callback
